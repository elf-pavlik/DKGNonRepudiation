specification {
  element actor { notation "Person"; style { shape person } }
  element system { }
  element service { style { shape component } }

  relationship didcomm { technology "DIDComm" }
  relationship http { technology "HTTPS" }

  tag nrread
  tag escrow
  tag evidence
}

model {
  user = actor "User" {
    title "Patient — Wallet + own SSI agent"
    summary "The patient's credential wallet (demo-user)."
    description """
      Holds the **ExampleDegreeCredential** issued by the secure issuer and approves
      proof requests coming from the apps over DIDComm.
      """
  }

  app = system "App" {
    title "App — client + own SSI agent"
    summary "Demo application (Private Clinic / Public Hospital replica)."
    description """
      Presents the user's Verifiable Presentation to the CSS, signs the
      **NonRepudiationDestination** receipt (NRR) and decrypts the resource locally.
      """
  }

  css = system "CSS Server" {
    title "Community Solid Server (modified)"
    summary "Pod and resource owner: VcDidCommHttpHandler, AgentInitializer, AcpReader, PermissionBasedAuthorizer."
    description """
      Issues the **NonRepudiableOrigin** NRO, escrows the symmetric key and releases it
      only against a verified **NRR** (`jwsGraphService.storeVerifiedJws` keeps the evidence).
      """
  }

  ttp = system "TTP" {
    title "Trusted Third Party"
    summary "Escrow holder and independent key releaser (demo-ttp)."
    description """
      Receives the encrypted resource (JWE for its own recipient key), verifies NRR/NRO
      consistency on `checkResource` and releases `keyForDecrypt` as an alternative to the CSS.
      """
  }

  issuer = system "Secure Issuer" {
    title "Secure Issuer — own SSI agent"
    summary "Issues the ExampleDegreeCredential to the wallet (secure-issuer)."
    description """
      `did:web:secureissuer.solidcommunity.net:public`. Connects to the wallet over DIDComm
      and runs the **issue-credential/2.0** protocol (LD-proof VC).
      """
  }

  // Canonical relationships (used by the context view; the dynamic views list steps explicitly)
  user -[didcomm]-> app "connects via OOB invitation"
  user -[didcomm]-> app "returns Verifiable Presentation"
  app -[didcomm]-> user "forwards (signed/wrapped) proof request"
  app -[http]-> css "requests resource (didvc/agent/client/issuer headers)"
  app -[http]-> css "retries with vp header, then signedresource header"
  css -[http]-> app "401 didcomm proofRequest / 200 resource / encryptedresource / keyfordecrypt"
  css -[didcomm]-> ttp "reserved escrow channel"
  app -[http]-> ttp "checkResource (encryptedMessage, nrr)"
  ttp -[http]-> app "keyForDecrypt"
  app -> user "delivers plaintext resource (app-specific)"
  issuer -[didcomm]-> user "issues ExampleDegreeCredential (issue-credential/2.0)"
  css -[http]-> ttp "keyExchange (did, publicKey, signature)"
}

views {
  // ---------------------------------------------------------------------------
  // Captured run — credential issuance, rebuilt from Tempo (live run, 2026-11-23).
  // Source traces: a37510f5… (invitation, connection, offer), 6d6a76eb… (request, issue, ack)
  // ---------------------------------------------------------------------------
  dynamic view credential-issuance-captured {
    variant sequence

    title "Credential issuance — captured run (Tempo)"
    description """
      Prerequisite of the non-repudiable read, outside the ProVerif model: **secure-issuer** issues
      the **ExampleDegreeCredential** to the wallet (**demo-user**) over DIDComm. Every DIDComm
      message is authcrypt-encrypted on the wire; the notes show the decrypted plaintext captured
      by the `didcomm.pack` / `didcomm.unpack` spans. Continues in `nr-read-flow-captured`.
      """

    user -> issuer "GET /generateInvitation" {
      technology "HTTPS"
      notes """
        The wallet UI (`POST` on demo-user, trace `a37510f5…`) asks the issuer for a DIDComm out-of-band
        invitation: `GET http://secure-issuer:8080/generateInvitation`.

        Response returned to the wallet UI:

        ```json
        {
          "ok": true,
          "issuerBaseUrl": "http://secure-issuer:8080",
          "connectionId": "ebab40a8-5bc1-4e39-9029-3424c847ecc3",
          "invitationUrl": "http://secure-issuer:3011?oob=eyJAdHlwZSI6Imh0dHBz…bGljIl19",
          "normalizedInvitationUrl": "http://secure-issuer:3011?oob=eyJAdHlwZSI6Imh0dHBz…bGljIl19"
        }
        ```

        Decoded `oob` parameter — the out-of-band invitation:

        ```json
        {
          "@type": "https://didcomm.org/out-of-band/1.1/invitation",
          "@id": "74b556dd-1778-4f06-a998-640c4355a311",
          "label": "SecureIssuer",
          "accept": [
            "didcomm/aip1",
            "didcomm/aip2;env=rfc19"
          ],
          "handshake_protocols": [
            "https://didcomm.org/didexchange/1.1",
            "https://didcomm.org/connections/1.0"
          ],
          "services": [
            "did:web:secureissuer.solidcommunity.net:public"
          ]
        }
        ```
        """
    }

    user -> issuer "didexchange/1.1 request" {
      technology "DIDComm"
      notes """
        The wallet answers the invitation (`~thread.pthid` = invitation `@id`) and proposes a fresh
        **peer DID** for this connection. `did_doc~attach` carries the peer DID document (service endpoint
        `http://demo-user:3006`, Ed25519 authentication key, X25519 key agreement), signed with the wallet's
        `did:web` key (`didlong`).

        Wire format — POST `http://secure-issuer:3011/` (authcrypt JWM, header decoded):

        ```json
        {
          "protected": {
            "base64 (decoded)": {
              "enc": "xchacha20poly1305_ietf",
              "typ": "JWM/1.0",
              "alg": "Authcrypt",
              "recipients": [
                {
                  "encrypted_key": "o64u510DumC8rR4Fa5qw9KFzRhOoBdLH0ulvX-TfQPDyomgF7TnUnmw35xweiXRd",
                  "header": {
                    "kid": "Aa8eUmtQ1yv4fCSnv1FkWkn1FqpzJWmKauJ5JvAkjFoU",
                    "sender": "PBNFu6xpFwsO6_M9jT8JgnbIe47tEzbc5GRroXGp9EQLIYmyFe…aWQSR4PU",
                    "iv": "p9pLdcvzyFHK-AWL0aBAGpGgUNur3neA"
                  }
                }
              ]
            }
          },
          "ciphertext": "WOj3zM3ME7_ubT5WnuPTs0PojtYf38fN556kOv-nLudOSVyUxl…uZvotqls",
          "iv": "Y23FLGaKwUXqXCVM",
          "tag": "0VvKdjvHBS50ZrpZsijGCQ"
        }
        ```

        Plaintext (`didcomm.pack` on demo-user):

        ```json
        {
          "@type": "https://didcomm.org/didexchange/1.1/request",
          "@id": "e6e1638f-e790-4378-b401-ceddc14f003a",
          "label": "SecureUserWallettttt",
          "did": "did:peer:1zQmcUrkEc6xwxvi8DApdXR6RnUsroCpbG9WcLkhipEerG5z",
          "didlong": "did:web:bboi.solidcommunity.net:public",
          "~thread": {
            "pthid": "74b556dd-1778-4f06-a998-640c4355a311"
          },
          "did_doc~attach": {
            "@id": "a41e0b64-4fbb-4b99-b4b4-d1920cc656ba",
            "mime-type": "application/json",
            "data": {
              "base64 (decoded)": {
                "@context": [
                  "https://w3id.org/did/v1"
                ],
                "id": "did:peer:1zQmcUrkEc6xwxvi8DApdXR6RnUsroCpbG9WcLkhipEerG5z",
                "service": [
                  {
                    "id": "#inline-0",
                    "serviceEndpoint": "http://demo-user:3006",
                    "type": "did-communication",
                    "priority": 0,
                    "recipientKeys": [
                      "#key-1"
                    ],
                    "routingKeys": []
                  }
                ],
                "authentication": [
                  {
                    "id": "#key-1",
                    "type": "Ed25519VerificationKey2018",
                    "controller": "#id",
                    "publicKeyBase58": "7rJqD6bwQuTZzeAfDDkoQFtN2HAe5HB7T9cgeta41B9j"
                  }
                ],
                "keyAgreement": [
                  {
                    "id": "#key-2",
                    "type": "X25519KeyAgreementKey2019",
                    "controller": "#id",
                    "publicKeyBase58": "2fXth2RVmxa79LqgDVes3mFMC8FpHN7g5X62njxEpuGa"
                  }
                ]
              },
              "jws": {
                "protected": "eyJhbGciOiJFZERTQSIsImp3ayI6eyJrdHkiOiJPS1AiLCJjcn…sNEkifX0",
                "signature": "H1MoA6G-xRo2TweJfIqq7txtbog9KasXOffMWeC01GMZAJMb7c…a43u4zDA",
                "header": {
                  "kid": "did:key:z6MksJS85b7ugR3Mr5FVfGMeL4HB25uvEjrn8zXYzptUrzTb"
                }
              }
            }
          }
        }
        ```
        """
    }

    issuer -> user "didexchange/1.1 response" {
      technology "DIDComm"
      notes """
        The issuer accepts and returns its own peer DID document (endpoint `http://secure-issuer:3011`),
        threaded to the request (`~thread.thid`).

        Plaintext (`didcomm.pack` on secure-issuer):

        ```json
        {
          "@type": "https://didcomm.org/didexchange/1.1/response",
          "@id": "040e9b09-1937-40a1-9f47-b42bb2135571",
          "did": "did:peer:1zQmSS8Wa981qHRaJZCUPEHb6yXphL7adiJHxcnPqh76NdMh",
          "~thread": {
            "thid": "e6e1638f-e790-4378-b401-ceddc14f003a"
          },
          "did_doc~attach": {
            "@id": "5896e988-bd43-4650-b13f-a08ec7af342b",
            "mime-type": "application/json",
            "data": {
              "base64 (decoded)": {
                "@context": [
                  "https://w3id.org/did/v1"
                ],
                "id": "did:peer:1zQmSS8Wa981qHRaJZCUPEHb6yXphL7adiJHxcnPqh76NdMh",
                "service": [
                  {
                    "id": "#inline-0",
                    "serviceEndpoint": "http://secure-issuer:3011",
                    "type": "did-communication",
                    "priority": 0,
                    "recipientKeys": [
                      "#key-1"
                    ],
                    "routingKeys": []
                  }
                ],
                "authentication": [
                  {
                    "id": "#key-1",
                    "type": "Ed25519VerificationKey2018",
                    "controller": "#id",
                    "publicKeyBase58": "EEr9Y67xkRVQfCsHXeNbNuNyre6wMZNSsDXynNQRj2xk"
                  }
                ],
                "keyAgreement": [
                  {
                    "id": "#key-2",
                    "type": "X25519KeyAgreementKey2019",
                    "controller": "#id",
                    "publicKeyBase58": "GnKT9e1SKobnuoo7vcuiYcUbAjca98cTftWNPSVeVQkN"
                  }
                ]
              },
              "jws": {
                "protected": "eyJhbGciOiJFZERTQSIsImp3ayI6eyJrdHkiOiJPS1AiLCJjcn…kUjgifX0",
                "signature": "hbia7MzzZkZF1FJyv_3uDrw_uwfpd8FH8bC4baHWPSXt8YG6La…7fQKzmAA",
                "header": {
                  "kid": "did:key:z6Mkp2Ph528qMXQXmhHVbaDbMrL15R6qiQ1gGvD19C8meUar"
                }
              }
            }
          }
        }
        ```
        """
    }

    user -> issuer "didexchange/1.1 complete" {
      technology "DIDComm"
      notes """
        Closes the handshake: from here on both sides encrypt with the peer DIDs' keys.

        Plaintext:

        ```json
        {
          "@type": "https://didcomm.org/didexchange/1.1/complete",
          "@id": "a5d83dc1-6260-4a14-b4ee-d46a17fa9fa6",
          "~thread": {
            "thid": "e6e1638f-e790-4378-b401-ceddc14f003a",
            "pthid": "74b556dd-1778-4f06-a998-640c4355a311"
          },
          "~transport": {
            "return_route": "none"
          }
        }
        ```
        """
    }

    issuer -> user "basicmessage/1.0" {
      technology "DIDComm"
      notes """
        Greeting sent by the issuer once the connection is active.

        Plaintext:

        ```json
        {
          "@type": "https://didcomm.org/basicmessage/1.0/message",
          "@id": "edec6885-8d28-4fa5-a4d2-65828dd873ab",
          "sent_time": "2026-11-23T17:58:42.975Z",
          "content": "Hello, we can start to communicate",
          "~l10n": {
            "locale": "en"
          }
        }
        ```
        """
    }

    issuer -> user "issue-credential/2.0 offer-credential" {
      technology "DIDComm"
      notes """
        The issuer offers an **ExampleDegreeCredential** for the wallet's `did:web`
        (`aries/ld-proof-vc-detail@v1.0`: credential body plus the proof options it will use).

        Plaintext (attachment decoded):

        ```json
        {
          "@type": "https://didcomm.org/issue-credential/2.0/offer-credential",
          "@id": "967d4bc7-9a4a-4bb8-adec-0e1ba24121a4",
          "formats": [
            {
              "attach_id": "2d04d7b9-e4d5-4cc2-a44f-1050e7b63253",
              "format": "aries/ld-proof-vc-detail@v1.0"
            }
          ],
          "credential_preview": {
            "@type": "https://didcomm.org/issue-credential/2.0/credential-preview",
            "attributes": []
          },
          "offers~attach": [
            {
              "@id": "2d04d7b9-e4d5-4cc2-a44f-1050e7b63253",
              "mime-type": "application/json",
              "data": {
                "base64 (decoded)": {
                  "credential": {
                    "@context": [
                      "https://www.w3.org/2018/credentials/v1",
                      "https://www.w3.org/2018/credentials/examples/v1"
                    ],
                    "id": "https://example.com/credentials/321122",
                    "type": [
                      "VerifiableCredential",
                      "ExampleDegreeCredential"
                    ],
                    "issuer": "did:web:secureissuer.solidcommunity.net:public",
                    "issuanceDate": "2010-01-01T19:23:24Z",
                    "credentialSubject": {
                      "id": "did:web:bboi.solidcommunity.net:public",
                      "degree": {
                        "type": "ExampleBachelorDegree",
                        "name": "Engineering"
                      }
                    }
                  },
                  "options": {
                    "proofPurpose": "assertionMethod",
                    "proofType": "Ed25519Signature2018"
                  }
                }
              }
            }
          ],
          "~thread": {
            "thid": "aa736a1d-4fae-48a4-bbd6-861ada44c67b"
          }
        }
        ```
        """
    }

    user -> issuer "issue-credential/2.0 request-credential" {
      technology "DIDComm"
      notes """
        The user accepts the offer in the wallet UI (trace `6d6a76eb…`); the wallet requests exactly the
        offered credential.

        Plaintext (attachment decoded):

        ```json
        {
          "@type": "https://didcomm.org/issue-credential/2.0/request-credential",
          "@id": "005a6fd9-d02a-456f-acc3-ba4ec782150e",
          "formats": [
            {
              "attach_id": "af08e298-0451-4d77-aa85-1b39e35f9dae",
              "format": "aries/ld-proof-vc-detail@v1.0"
            }
          ],
          "requests~attach": [
            {
              "@id": "af08e298-0451-4d77-aa85-1b39e35f9dae",
              "mime-type": "application/json",
              "data": {
                "base64 (decoded)": {
                  "credential": {
                    "@context": [
                      "https://www.w3.org/2018/credentials/v1",
                      "https://www.w3.org/2018/credentials/examples/v1"
                    ],
                    "id": "https://example.com/credentials/321122",
                    "type": [
                      "VerifiableCredential",
                      "ExampleDegreeCredential"
                    ],
                    "issuer": "did:web:secureissuer.solidcommunity.net:public",
                    "issuanceDate": "2010-01-01T19:23:24Z",
                    "credentialSubject": {
                      "id": "did:web:bboi.solidcommunity.net:public",
                      "degree": {
                        "type": "ExampleBachelorDegree",
                        "name": "Engineering"
                      }
                    }
                  },
                  "options": {
                    "proofPurpose": "assertionMethod",
                    "proofType": "Ed25519Signature2018"
                  }
                }
              }
            }
          ],
          "~attach": [],
          "~thread": {
            "thid": "aa736a1d-4fae-48a4-bbd6-861ada44c67b"
          }
        }
        ```
        """
    }

    issuer -> user "issue-credential/2.0 issue-credential" {
      technology "DIDComm"
      notes """
        `vc.issue` on secure-issuer signs the credential (`Ed25519Signature2018`, `assertionMethod`);
        the wallet checks it with `vc.verifyCredential` and stores it.

        Plaintext (attachment decoded — the signed VC):

        ```json
        {
          "@type": "https://didcomm.org/issue-credential/2.0/issue-credential",
          "@id": "72a37501-2b84-49c9-af6c-f3dc0efb0396",
          "formats": [
            {
              "attach_id": "6db40718-f5ba-4ad7-a75c-912724cc5d3a",
              "format": "aries/ld-proof-vc@v1.0"
            }
          ],
          "credentials~attach": [
            {
              "@id": "6db40718-f5ba-4ad7-a75c-912724cc5d3a",
              "mime-type": "application/json",
              "data": {
                "base64 (decoded)": {
                  "@context": [
                    "https://www.w3.org/2018/credentials/v1",
                    "https://www.w3.org/2018/credentials/examples/v1"
                  ],
                  "id": "https://example.com/credentials/321122",
                  "type": [
                    "VerifiableCredential",
                    "ExampleDegreeCredential"
                  ],
                  "issuer": "did:web:secureissuer.solidcommunity.net:public",
                  "issuanceDate": "2010-01-01T19:23:24Z",
                  "credentialSubject": {
                    "degree": {
                      "type": "ExampleBachelorDegree",
                      "name": "Engineering"
                    },
                    "id": "did:web:bboi.solidcommunity.net:public"
                  },
                  "proof": {
                    "verificationMethod": "did:web:secureissuer.solidcommunity.net:public#z6M…9C8meUar",
                    "type": "Ed25519Signature2018",
                    "created": "2026-11-23T17:59:00Z",
                    "proofPurpose": "assertionMethod",
                    "jws": "eyJhbGciOiJFZERTQSIsImI2NCI6ZmFsc2UsImNyaXQiOlsiYj…YfE_uBAw"
                  }
                }
              }
            }
          ],
          "~thread": {
            "thid": "aa736a1d-4fae-48a4-bbd6-861ada44c67b"
          },
          "~please_ack": {
            "on": [
              "RECEIPT"
            ]
          }
        }
        ```
        """
    }

    user -> issuer "issue-credential/2.0 ack" {
      technology "DIDComm"
      notes """
        Acknowledges receipt (`~please_ack` of the previous message).

        Plaintext:

        ```json
        {
          "@type": "https://didcomm.org/issue-credential/2.0/ack",
          "@id": "8142044e-3a44-4cab-81ca-008f9dedb514",
          "status": "OK",
          "~thread": {
            "thid": "aa736a1d-4fae-48a4-bbd6-861ada44c67b"
          }
        }
        ```
        """
    }
  }

  // ---------------------------------------------------------------------------
  // Captured runs — rebuilt from Tempo spans (live runs, 2026-11-23).
  // Message numbers follow the ProVerif model didcomm_ver_upd_agreement_complete_23nov.pv
  // (verifier V = CSS). Source traces:
  //   run 1, release via CSS (5a): 219fcbd5… 478d500f… 3323226b… 3c58b6bb… 28e7f75c… 9a67fc35… 6ed104ef… 4fbb8cd9… 47686a35…
  //   run 2, release via TTP (5b): c37b5723… ee3fa6a0… 401c8ab5… 75942e00… 52b3f72b… 714252ce… 3472aa18… d505b100…
  //   run 3, trusted hospital (3a): c79a3b2a… 70fd58cd… 7f44656d… 170830e9… b31760ef… 25118f7e… 19f064f2…
  // ---------------------------------------------------------------------------
  dynamic view nr-read-flow-captured {
    variant sequence

    title "Non-repudiable read — captured runs (Tempo)"
    description """
      Every cross-service message of three live runs, rebuilt from the OpenTelemetry spans in Tempo
      (**demo-user** = wallet, **demo-app-1** = Private Clinic, **demo-app-2** = Public Hospital,
      **solid-css**, **demo-ttp**). Labels carry the message number of the ProVerif model.
      DIDComm messages are authcrypt-encrypted on the wire: notes show the decrypted plaintext
      captured by the `didcomm.pack` / `didcomm.unpack` spans. Polling, static assets and
      did/context resolution are left out. The wallet already holds the credential:
      see `credential-issuance-captured`.
      """

    user -> app "m1 · didexchange/1.1 request" {
      technology "DIDComm"
      notes """
        **Phase 1 — connection** (traces `219fcbd5…`, `478d500f…`). The app UI calls `GET /generateInvitation`
        and shows the invitation; the user pastes it into the wallet (`POST` on demo-user).

        Invitation returned by the app:

        ```json
        {
          "url": "http://demo-app-1:3010?oob=eyJAdHlwZSI6Imh0dHBzOi8…bGljIl19"
        }
        ```

        Decoded `oob` — the out-of-band invitation (`label` = Private Clinic):

        ```json
        {
          "@type": "https://didcomm.org/out-of-band/1.1/invitation",
          "@id": "16dfc00d-f7fa-4aa3-8fe8-c3913ac49100",
          "label": "Private Clinic",
          "accept": [
            "didcomm/aip1",
            "didcomm/aip2;env=rfc19"
          ],
          "handshake_protocols": [
            "https://didcomm.org/didexchange/1.1",
            "https://didcomm.org/connections/1.0"
          ],
          "services": [
            "did:web:privateclinic.solidcommunity.net:public"
          ]
        }
        ```

        The wallet answers with a fresh **peer DID** whose document (`did_doc~attach`) is signed with the
        user's `did:web` key.

        Wire format — POST `http://demo-app-1:3010/` (authcrypt JWM, header decoded):

        ```json
        {
          "protected": {
            "base64 (decoded)": {
              "enc": "xchacha20poly1305_ietf",
              "typ": "JWM/1.0",
              "alg": "Authcrypt",
              "recipients": [
                {
                  "encrypted_key": "_prI-oVVuyUQy9LgoJWJnF6YRb-PgO8NfZctOqEXfXcTlF_s0uJYFgcVLkBqPm-O",
                  "header": {
                    "kid": "HgRt92NuzosbKRgN4wbebNzMDFESsYo8wYCT33wTM3K3",
                    "sender": "jxl4ld-gYcqoU8jp3PcKEfARqWv37mCOqaX2Oq8NOk5_zbEDLN…2Vz_HEno",
                    "iv": "49_XkYHu6RRCZnjSqL0INnbWBnX_wWFh"
                  }
                }
              ]
            }
          },
          "ciphertext": "cwfuplgw7jVNY5PXgMAgvdxsyj-utVSqvEsBJpME_oK5Lz-ySP…ga2HPDxK",
          "iv": "6FK5D28sR3JML8h_",
          "tag": "Fyt4APi87vtcwkYdFF0bCw"
        }
        ```

        Plaintext (`didcomm.pack` on demo-user):

        ```json
        {
          "@type": "https://didcomm.org/didexchange/1.1/request",
