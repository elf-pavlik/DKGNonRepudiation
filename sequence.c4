              "https://www.w3.org/2018/credentials/v1",
              "https://identity.foundation/presentation-exchange/submission/v1",
              "https://bboi.solidcommunity.net/public/schemas/202…l.jsonld"
            ],
            "requestACP": {
              "type": [
                "ACPContext"
              ],
              "target": "http://localhost:3002/my-pod/test-folder/dual-mode-resource.txt",
              "owner": "did:web:raw.githubusercontent.com:biagioboi:Commun…ver:main",
