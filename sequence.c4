                        "ldp_vp": {
                          "proof_type": [
                            "Ed25519Signature2018"
                          ]
                        },
                        "ldp": {
                          "proof_type": [
                            "RsaSignature2018"
                          ]
                        }
                      },
                      "requestACP": {
