{
  "@context": {
    "acp": "https://www.w3.org/ns/solid/acp#",
    "id": "@id",
    "vpr": "https://bboi.solidcommunity.net/definition/credentials#",
    "ourProtocol": "https://bboi.solidcommunity.net/definition/ourProtocol#",
    "type": "@type",
    "definedACPContext": "ourProtocol:context",
    "ACPContext": {
      "@id": "acp:Context", 
      "@type": "@id",
      "@context": {
        "@version": 1.1,
        "id": "@id",
        "type": "@type",
        "attribute": "acp:attribute",
        "target": "acp:target",
        "agent": "acp:agent",
        "creator": "acp:creator",
        "owner": "acp:owner",
        "client": "acp:client",
        "issuer": "acp:issuer"
      }
    },
    "VerifiablePresentationRequest": {
      "@id": "vpr:VerifiablePresentationRequest",
      "@type": "@id",
      "@context": {
        "@version": 1.1,
        "id": "@id",
        "type": "@type",
        "presentation_definition": {
          "@id": "vpr:presentationDefinition",
          "@type": "@id",
          "@context": {
            "@version": 1.1,
            "id": "vpr:idPresentation",
            "type": "@type",
            "definedACPContext": {
              "@id": "ourProtocol:context",
              "@type": "@id",
              "@context": {
                "attribute": "acp:attribute",
                "target": "acp:target",
                "agent": "acp:agent",
                "creator": "acp:creator",
                "owner": "acp:owner",
                "client": "acp:client",
                "issuer": "acp:issuer"
              }
            },
            "input_descriptors": {
              "@id": "vpr:inputDescriptors",
              "@context": {
                "name": "vpr:name",
                "purpose": "vpr:purpose",
                "constraints": {
                  "@id": "vpr:constraints",
                  "@context": {
                    "fields": {
                      "@id": "vpr:fields",
                      "@context": {
                        "path": "vpr:path"
                      }
                    }
                  }
                }
              }
            },
            "format": {
              "@id": "vpr:format",
              "@type": "@id",
              "@context": {
                "ldp_vc": {
                  "@id": "vpr:ldp_vc",
                  "@context": {
                    "proof_type": "vpr:proofType"
                  }
                },
                "ldp": {
                  "@id": "vpr:ldp",
                  "@context": {
                    "proof_type": "vpr:proofType"
                  }
                },
                "ldp_vp": {
                  "@id": "vpr:ldp_vp",
                  "@context": {
                    "proof_type": "vpr:proofType"
                  }
                }
              }
            }
          }
        },
        "options": {
          "@id": "vpr:options",
          "@type": "@id",
          "@context": {
            "@version": 1.1,
            "id": "@id",
            "challenge": "vpr:challenge",
            "domain": "vpr:domain",
            "type": "@type"
          }
        }
      }
    }
  }
}