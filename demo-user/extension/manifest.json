{
  "manifest_version": 3,
  "name": "Hospital Patient Wallet",
  "version": "1.0.0",
  "description": "Browser companion for the DIDComm patient wallet.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Patient Wallet",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://localhost:3007/*",
    "http://127.0.0.1:3007/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:8080/*",
      "http://127.0.0.1:8080/*",
      "http://localhost:8081/*",
      "http://127.0.0.1:8081/*",
      "http://localhost:8082/*",
      "http://127.0.0.1:8082/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "popup.css"
      ],
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:8081/*",
        "http://127.0.0.1:8081/*",
        "http://localhost:8082/*",
        "http://127.0.0.1:8082/*"
      ]
    }
  ]
}
